rules_version = '2';

// Command Deck — every document lives under the owner's UID and is
// readable/writable by nobody else. Paste this into
// Firebase console → Firestore Database → Rules → Publish.
//
// The web app's API key is public (it ships in the GitHub Pages bundle,
// as Firebase intends). These rules, not the key, are what protect the
// data — so they are the only thing standing between your board and the
// internet. Read them before publishing.

service cloud.firestore {
  match /databases/{database}/documents {

    match /users/{userId} {

      // The user document itself (holds nothing but a display name today).
      allow read, write: if isOwner(userId);

      match /items/{itemId} {
        allow read, delete: if isOwner(userId);
        allow create, update: if isOwner(userId) && validItem();
      }

      match /categories/{categoryId} {
        allow read, delete: if isOwner(userId);
        allow create, update: if isOwner(userId) && validCategory();
      }

      // ---- app releases ----
      match /apps/{appId} {
        allow read, delete: if isOwner(userId);
        allow create, update: if isOwner(userId) && validApp();
      }

      match /releases/{releaseId} {
        allow read, delete: if isOwner(userId);
        allow create, update: if isOwner(userId) && validRelease();
      }

      // ---- work timeline ----
      //
      // Plaintext, unlike the vault. These rules are therefore the ONLY thing
      // protecting the contents, not a second line behind encryption — which
      // is worth remembering before anything client-confidential is attached.
      match /events/{eventId} {
        allow read, delete: if isOwner(userId);
        allow create, update: if isOwner(userId) && validEvent();
      }

      // Projects are shared between the timeline and the visibility board.
      // The board added client/status/summary/order; a project written by the
      // old timeline code has none of them, which is why they are all optional.
      match /projects/{projectId} {
        allow read, delete: if isOwner(userId);
        allow create, update: if isOwner(userId) && validProject();
      }

      // ---- team visibility board ----
      //
      // Components are the deliverables inside a project — the iOS build, the
      // web portal. They succeed `apps`, which is left in place: the migration
      // copies, it does not move, so a half-finished run is not a broken board.
      match /components/{componentId} {
        allow read, delete: if isOwner(userId);
        allow create, update: if isOwner(userId) && validComponent();
      }

      // Specs are prettified Word documents. Plaintext, and often the most
      // commercially sensitive thing on the board — a client's unreleased
      // requirements. These rules are the only thing protecting them.
      match /specs/{specId} {
        allow read, delete: if isOwner(userId);
        allow create, update: if isOwner(userId) && validSpec();
      }

      // ---- credentials vault ----
      //
      // These rules are a second line of defence, not the first. The vault's
      // contents are encrypted client-side before they are written, so an
      // attacker who defeats everything below still gets ciphertext. That is
      // deliberate: rules are one careless edit away from being wrong, and
      // this data is the kind where "mostly protected" is not a category.
      //
      // What the shape checks buy: they make it impossible for a bug — or a
      // client that has been tampered with — to write a vault document whose
      // body is plaintext. A document without a `data.ct` string is rejected.

      // config is the vault's key material; anything else under vaultMeta is a
      // sealed blob encrypted under the same key — the Claude API key lives
      // here rather than anywhere it could be read.
      match /vaultMeta/{docId} {
        allow read, delete: if isOwner(userId);
        allow create, update: if isOwner(userId) && (validVaultConfig() || validVaultEntry());
      }

      match /vault/{entryId} {
        allow read, delete: if isOwner(userId);
        allow create, update: if isOwner(userId) && validVaultEntry();
      }

      // Group names are encrypted exactly like entries. A plaintext folder
      // called "production database" would tell a reader what the credentials
      // are FOR, which is often the more useful half of the secret.
      match /vaultGroups/{groupId} {
        allow read, delete: if isOwner(userId);
        allow create, update: if isOwner(userId) && validVaultEntry();
      }
    }

    // Anything not matched above is denied by default. Leave it that way.

    function isOwner(userId) {
      return request.auth != null && request.auth.uid == userId;
    }

    // Shape checks. These are not security-critical — you are the only
    // writer — but they stop a bug in one client from writing garbage
    // the other client then has to defend against.
    function validItem() {
      let d = request.resource.data;
      return d.title is string
          && d.title.size() <= 2000
          && d.bucket in ['now', 'waiting', 'later']
          && d.done is bool
          && d.urgent is bool
          && d.order is number
          && d.subs is list
          && d.subs.size() <= 200;
    }

    // The vault's shape checks ARE security-relevant, unlike the two above:
    // they are what stops a plaintext password from ever being stored, even
    // by accident. A document is only accepted if its body is a sealed blob.
    function validVaultConfig() {
      let d = request.resource.data;
      return d.v is int
          && d.salt is string && d.salt.size() >= 16 && d.salt.size() <= 64
          && d.iterations is int && d.iterations >= 100000
          && d.verifier.ct is string && d.verifier.iv is string
          && d.createdAt is string;
    }

    // Shared by vault entries and vault groups: both are nothing but a sealed
    // blob plus timestamps. updatedAt is optional — a freshly created group
    // has never been updated.
    function validVaultEntry() {
      let d = request.resource.data;
      return d.v is int
          // `order` is a hand-chosen list position, stored outside the
          // ciphertext so dragging a row writes an integer instead of
          // re-encrypting every document it moved past. It says nothing
          // about the credential, which is why it is allowed to be readable.
          && d.keys().hasOnly(['v', 'data', 'order', 'createdAt', 'updatedAt'])
          && (!d.keys().hasAny(['order']) || d.order is number)
          && d.data.keys().hasOnly(['ct', 'iv'])
          && d.data.ct is string && d.data.ct.size() > 0 && d.data.ct.size() <= 100000
          && d.data.iv is string && d.data.iv.size() > 0 && d.data.iv.size() <= 32
          && d.createdAt is string
          // Optional: a document that has never been edited has no updatedAt,
          // which is how every group is born. Requiring it would reject group
          // creation outright with a permission error.
          && (!d.keys().hasAny(['updatedAt']) || d.updatedAt is string);
    }

    function validApp() {
      let d = request.resource.data;
      return d.name is string && d.name.size() > 0 && d.name.size() <= 80
          && d.platform is string
          && d.repoUrl is string && d.artifactUrl is string
          && d.notes is string && d.notes.size() <= 20000
          && d.color is string && d.color.matches('^#[0-9A-Fa-f]{6}$')
          && d.createdAt is string;
    }

    function validRelease() {
      let d = request.resource.data;
      return d.appId is string && d.appId.size() > 0
          && d.version is string && d.version.size() <= 80
          && d.build is string && d.build.size() <= 80
          && d.env is string && d.env.size() <= 120
          && d.changes is string && d.changes.size() <= 20000
          && d.sourceUrl is string && d.artifactUrl is string
          // A planned release has not been built yet, so it is the one case
          // where buildDate is allowed to be empty.
          && d.buildDate is string
          && (d.buildDate.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
              || (d.keys().hasAny(['planned']) && d.planned == true && d.buildDate == ''))
          // The flag is a real boolean, so a truthy string cannot mark
          // something as shipped, and a shipped release carries its date.
          && d.production is bool
          && (d.production == false ? d.prodDate == '' : d.prodDate.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$'))
          && d.notes is string && d.notes.size() <= 20000
          && d.createdAt is string && d.updatedAt is string
          // Board fields, all optional. `componentId` is what the migration
          // adds; `appId` above is deliberately still required, so a release
          // always remains readable by a client that predates the board.
          && (!d.keys().hasAny(['componentId']) || d.componentId is string)
          && (!d.keys().hasAny(['planned']) || d.planned is bool)
          && (!d.keys().hasAny(['targetDate'])
              || d.targetDate == '' || d.targetDate.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$'))
          && (!d.keys().hasAny(['status'])
              || d.status in ['planned', 'building', 'qa', 'released', 'live', 'blocked', 'cancelled'])
          && (!d.keys().hasAny(['blocker']) || (d.blocker is string && d.blocker.size() <= 500));
    }

    function validEvent() {
      let d = request.resource.data;
      return d.title is string && d.title.size() > 0 && d.title.size() <= 200
          && d.date is string && d.date.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
          && d.body is string && d.body.size() <= 20000
          && d.projectId is string
          && d.attachments is list
          && d.attachments.size() <= 12
          && d.createdAt is string
          && d.updatedAt is string;
    }

    function validProject() {
      let d = request.resource.data;
      return d.name is string && d.name.size() > 0 && d.name.size() <= 80
          && d.color is string && d.color.matches('^#[0-9A-Fa-f]{6}$')
          && d.createdAt is string
          // Board fields, all optional: a project created by the timeline has
          // none of them, and rejecting those would break the timeline.
          && (!d.keys().hasAny(['client']) || (d.client is string && d.client.size() <= 80))
          && (!d.keys().hasAny(['status'])
              || d.status in ['active', 'paused', 'shipped', 'archived'])
          && (!d.keys().hasAny(['summary']) || (d.summary is string && d.summary.size() <= 300))
          && (!d.keys().hasAny(['order']) || d.order is number);
    }

    function validComponent() {
      let d = request.resource.data;
      return d.projectId is string && d.projectId.size() > 0
          && d.name is string && d.name.size() > 0 && d.name.size() <= 80
          && d.platform in ['ios', 'android', 'web', 'portal', 'backend', 'other']
          && d.repoUrl is string && d.repoUrl.size() <= 2000
          && d.artifactUrl is string && d.artifactUrl.size() <= 2000
          && d.notes is string && d.notes.size() <= 20000
          && d.color is string && d.color.matches('^#[0-9A-Fa-f]{6}$')
          && d.order is number
          && d.createdAt is string;
    }

    // A spec is one version of one document. Versions are never edited, only
    // superseded, so `version` must be a positive integer and the body sizes
    // are capped at what the client refuses to upload anyway — the cap is here
    // too, because a cap enforced only in the client is not a cap.
    function validSpec() {
      let d = request.resource.data;
      return d.projectId is string && d.projectId.size() > 0
          && d.componentId is string
          && d.title is string && d.title.size() > 0 && d.title.size() <= 200
          && d.html is string && d.html.size() > 0 && d.html.size() <= 400000
          && d.text is string && d.text.size() <= 200000
          && d.outline is list && d.outline.size() <= 200
          && d.wordCount is number
          && d.sourceName is string && d.sourceName.size() <= 300
          && d.version is int && d.version >= 1
          && d.createdAt is string;
    }

    function validCategory() {
      let d = request.resource.data;
      return d.name is string
          && d.name.size() > 0
          && d.name.size() <= 100
          && d.color is string
          && d.color.matches('^#[0-9A-Fa-f]{6}$');
    }
  }
}

// ---------------------------------------------------------------------
// Optional hardening: once you know your own UID (Firebase console →
// Authentication → Users), you can pin access to exactly that account so
// that even a stranger who signs in with Google gets nothing:
//
//   function isOwner(userId) {
//     return request.auth != null
//         && request.auth.uid == userId
//         && request.auth.uid == 'PASTE_YOUR_UID_HERE';
//   }
//
// Worth doing. Without it, anyone can sign in and create their own empty
// board in your project — harmless to your data, but it is your quota.
// ---------------------------------------------------------------------
